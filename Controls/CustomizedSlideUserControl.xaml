<UserControl x:Class="GcjUiCtrl.Control.CustomizedSlideUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GcjUiCtrl.Control"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="200">
    <UserControl.Resources>

        <Storyboard x:Key="SlideRightToLeft">
            <!-- ImgForeGround 从控件宽度位置滑入到位置 0 -->
            <DoubleAnimation Storyboard.TargetName="ImgForeGround"
                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                         From="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         To="0"
                         Duration="0:0:2" />
            <!-- ImgBackGround 渐隐 -->
            <DoubleAnimation Storyboard.TargetName="ImgBackGround"
                         Storyboard.TargetProperty="Opacity"
                         From="1" To="0"
                         Duration="0:0:2" />
        </Storyboard>

        <Storyboard x:Key="SlideLeftToRight">
            <DoubleAnimation Storyboard.TargetName="ImgForeGround"
                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                 From="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 To="0"
                 Duration="0:0:2" />
            <DoubleAnimation Storyboard.TargetName="ImgBackGround"
                 Storyboard.TargetProperty="Opacity"
                 From="1" To="0"
                 Duration="0:0:2" />
        </Storyboard>

        <Storyboard x:Key="SlideTopToBottom">
            <DoubleAnimation Storyboard.TargetName="ImgForeGround"
                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                 From="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 To="0"
                 Duration="0:0:2" />
            <DoubleAnimation Storyboard.TargetName="ImgBackGround"
                 Storyboard.TargetProperty="Opacity"
                 From="1" To="0"
                 Duration="0:0:2" />
        </Storyboard>


        <Storyboard x:Key="SlideBottomToTop">
            <DoubleAnimation Storyboard.TargetName="ImgForeGround"
                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                 From="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 To="0"
                 Duration="0:0:2" />
            <DoubleAnimation Storyboard.TargetName="ImgBackGround"
                 Storyboard.TargetProperty="Opacity"
                 From="1" To="0"
                 Duration="0:0:2" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- 背景图片 -->
        <Image 
            x:Name="ImgBackGround" Stretch="Fill" Source="/Resources/control4.png"                              
            Width="{Binding Width, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Height="{Binding Height, RelativeSource={RelativeSource AncestorType=UserControl}}"
            />
        <!--MaxHeight="{Binding MaxHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
            MaxWidth="{Binding MaxWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"-->
        <!-- 前景图片，用于滑动效果 -->
        <Image 
            x:Name="ImgForeGround" Stretch="Fill" Source="/Resources/control5.png" 
            Width="{Binding Width, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Height="{Binding Height, RelativeSource={RelativeSource AncestorType=UserControl}}"
            >
            <Image.RenderTransform>
                <TranslateTransform />
            </Image.RenderTransform>
        </Image>
    </Grid>
</UserControl>
