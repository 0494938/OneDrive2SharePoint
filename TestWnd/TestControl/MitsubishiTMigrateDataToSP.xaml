<ctrl:GcjBaseWindow x:Class="IsidTestApp.MitsubishiTMigrateDataToSP"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:IsidTestApp"
        xmlns:ctrl="clr-namespace:GcjUiCtrl.Control"
        xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        WindowStartupLocation="CenterScreen" WindowState="Normal"  
        mc:Ignorable="d"
        CustomizedBgColor="AliceBlue" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Title="TestControlWindow" Height="600" Width="900" LayoutUpdated="GcjBaseWindow_LayoutUpdated" Loaded="GcjBaseWindow_Loaded">

    <Window.DataContext>
        <local:TestContext/>
    </Window.DataContext>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Comm/GcjCustomizedCtrl.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RgnBorder" CornerRadius="20" Background="{Binding Path=CustomizedBgBrush,Mode=OneWay}" BorderThickness="0.5" BorderBrush="Gray">
        <Grid x:Name="gridMain" Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition  Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition  Height="16" />
            </Grid.RowDefinitions>

            <ctrl:CustomizedTitleControl  Margin="5,1,5,1"
                 Grid.Row="0" x:Name="gridTitle" Style="{DynamicResource xCustomizedTitleControlStyle}"
                 ShowBkColorPicker="Collapsed"
                 ShowMinimumButton="Collapsed"
                 ShowMaximumButton="Collapsed"
                 SelectedColor="BlueViolet"
                 SelectedColorChanged="OnBackGroundColorChanged"
                 TitleText="MMC OneDrive Migrate Files to SharePoint" TitleImageSource="/Resources/Auto8.jpg"
                 TitleIconMargin="-10,-10,-5,-5"
                 TitleForeGround="Black"
                 ColorPickerMargin="0,-3,34,0"
                 ColorPickerHeight="12"
                 ColorPickerFontSize="8"
                 ColorPickerWidth="150"
                 StartIconAnimation="True" LayoutUpdated="gridTitle_LayoutUpdated" Loaded="gridTitle_Loaded"
                 />
            <ctrl:CustomizedScrollControl Grid.Row="1" x:Name="grdLeft" LayoutUpdated="grdLeft_LayoutUpdated" Loaded="grdLeft_Loaded">
                <Grid  >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Grid.Column="0"  VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="データソース" Foreground="{Binding Path=CustomizedFgBrush,Mode=OneWay}" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,5,0,5"/>
                        <ctrl:CustomizedImageButton Style="{DynamicResource xCustomizedImageButtonStyle}" Grid.Column="1"
                          Text="..." ImageSource="/TestWnd/TestControl/Folder1.png" 
                          x:Name="btnSrcBrowser" Click="btnSrcBrowser_Click" 
                          Height="26" Margin="0,2,0,2"
                          FontSize="12"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          StartIconAnimation="False" >
                        </ctrl:CustomizedImageButton>
                    </Grid>

                    <Grid Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="5,1,5,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="コピーターゲット" Foreground="{Binding Path=CustomizedFgBrush,Mode=OneWay}" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,5,0,5" HorizontalAlignment="Stretch"/>
                        <ctrl:CustomizedImageButton Style="{DynamicResource xCustomizedImageButtonStyle}" Grid.Column="1"
                          Text="..." ImageSource="/TestWnd/TestControl/Folder1.png" 
                          x:Name="btnDstBrowser" Click="btnDstBrowser_Click" 
                          Height="26" Margin="0,2,0,2"
                          FontSize="12"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          StartIconAnimation="False" >
                        </ctrl:CustomizedImageButton>
                    </Grid>
                    <StackPanel Grid.Row="1" Grid.Column="0" Height="26" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,1,5,1">
                        <TextBlock VerticalAlignment="Center">
                            OneDrive：
                            <Hyperlink NavigateUri="https://mchcgr-my.sharepoint.com/?source=waffle" RequestNavigate="Hyperlink_RequestNavigate">
                                https://mchcgr-my.sharepoint.com/?source=waffle
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Height="26" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,1,5,1">
                        <TextBlock VerticalAlignment="Center">
                            Share Point：
                            <Hyperlink NavigateUri="https://mchcgr.sharepoint.com/:f:/r/sites/MCJP-DP-101W5/101W530_All/%E7%A4%BE%E5%A4%96%E5%85%B1%E6%9C%89/CSA%E6%94%B9%E4%BF%AE2024%E4%BD%9C%E6%A5%AD%E7%94%A8/TMP?csf=1&amp;web=1&amp;e=MuHkaN" RequestNavigate="Hyperlink_RequestNavigate">
                             101W530 コーポレートソリューションデリバリー部 全員 - 社外共有 - CSA改修2024作業用 - TMP
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <TreeView ItemsSource="{Binding SrcFolders}" Grid.Row="3" Grid.Column="0" >
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type local:SrcNodeViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <CheckBox IsChecked="{Binding IsChecked}" IsThreeState="True" VerticalAlignment="Center" />
                                    <Image x:Name="Icon" Width="16" Height="16" Margin="5,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>

                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                        <Setter TargetName="Icon" Property="Source" Value="/Icons/folder.close.png" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsFolder}" Value="True" />
                                            <Condition Binding="{Binding IsExpanded}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Icon" Property="Source" Value="/Icons/folder.open.png" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding IsFolder}" Value="False">
                                        <Setter TargetName="Icon" Property="Source" Value="/Icons/file.png" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <TreeView ItemsSource="{Binding DstFolders}" Grid.Row="3" Grid.Column="2" >
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type local:DstNodeViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Image x:Name="NodeIcon" Width="16" Height="16" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>

                                <HierarchicalDataTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsFolder}" Value="True" />
                                            <Condition Binding="{Binding Status}" Value="Pending" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="NodeIcon" Property="Source" Value="/Icons/folder_pending.png" />
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsFolder}" Value="True" />
                                            <Condition Binding="{Binding Status}" Value="Processing" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="NodeIcon" Property="Source" Value="/Icons/folder_processing.png" />
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsFolder}" Value="True" />
                                            <Condition Binding="{Binding Status}" Value="Completed" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="NodeIcon" Property="Source" Value="/Icons/folder_completed.png" />
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsFolder}" Value="False" />
                                            <Condition Binding="{Binding Status}" Value="Pending" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="NodeIcon" Property="Source" Value="/Icons/file_pending.png" />
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsFolder}" Value="False" />
                                            <Condition Binding="{Binding Status}" Value="Processing" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="NodeIcon" Property="Source" Value="/Icons/file_processing.png" />
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsFolder}" Value="False" />
                                            <Condition Binding="{Binding Status}" Value="Completed" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="NodeIcon" Property="Source" Value="/Icons/file_completed.png" />
                                    </MultiDataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <Border CornerRadius="8" Grid.Row="4" Height="200" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBox IsReadOnly="True" x:Name="txtLog" 
                                 Text="folder1\aaa.txt copy 200KB finished.&#x0a;folder1\aaa.ppt copy 2567KB finished&#x0a;....&#x0a;folder1\xxxxx#xxxxx.xlsx renamed to folder1\xxxxx＃xxxxx.xlsx, 13MB copy finished.&#x0a;..."/>
                    </Border>
                    <!--<Rectangle Grid.Column="1" Fill="DarkGray" Grid.Row="0" Grid.RowSpan="2"/>-->
                </Grid>
            </ctrl:CustomizedScrollControl>
            <ctrl:CustomizedStatusBarGrid Grid.Row="2" Style="{DynamicResource xCustomizedStatusBarControlStyle}"
                x:Name="gridStatusBar" Background="Transparent">
                <!--<StackPanel x:Name="stkStatusBar"  Orientation="Horizontal" >
                    <TextBlock x:Name="toolStripStatusFileName" Foreground="{Binding Path=CustomizedFgBrush,Mode=OneWay}" ToolTip="Status Area">Status Area ...</TextBlock>
                </StackPanel>-->
                <Grid x:Name="stkStatusBar">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="toolStripStatusFileName" Grid.Column="0" Foreground="{Binding Path=CustomizedFgBrush,Mode=OneWay}" ToolTip="Status Area">Status Area ...</TextBlock>
                    <ProgressBar x:Name="toolStripStatusProgess" Grid.Column="1" Value="50" Width="200"/>
                </Grid>
            </ctrl:CustomizedStatusBarGrid>
        </Grid>
    </Border>
</ctrl:GcjBaseWindow>

    