<ctrl:GcjBaseWindow x:Class="IsidTestApp.IsidTestControlWindowBak1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:IsidTestApp"
        xmlns:ctrl="clr-namespace:GcjUiCtrl.Control"
        xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        WindowStartupLocation="CenterScreen" WindowState="Normal"  
        mc:Ignorable="d"
        CustomizedBgColor="AliceBlue" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Title="TestControlWindow" Height="600" Width="1200" LayoutUpdated="GcjBaseWindow_LayoutUpdated" Loaded="GcjBaseWindow_Loaded">

    <Window.DataContext>
        <local:TestContext/>
    </Window.DataContext>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Comm/GcjCustomizedCtrl.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RgnBorder" CornerRadius="20" Background="{Binding Path=CustomizedBgBrush,Mode=OneWay}" BorderThickness="0.5" BorderBrush="Gray">
        <Grid x:Name="gridMain" Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition  Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition  Height="16" />
            </Grid.RowDefinitions>

            <ctrl:CustomizedTitleControl 
                 Grid.Row="0" x:Name="gridTitle" Style="{DynamicResource xCustomizedTitleControlStyle}"
                 ShowBkColorPicker="Collapsed"
                 ShowMinimumButton="Collapsed"
                 ShowMaximumButton="Collapsed"
                 SelectedColor="BlueViolet"
                 SelectedColorChanged="OnBackGroundColorChanged"
                 TitleText="Encoding Detect/Change Tools" TitleImageSource="/Resources/Test3.jpg" 
                 TitleIconMargin="-10,-10,-5,-5"
                 TitleForeGround="Black"
                 ColorPickerMargin="0,-3,34,0"
                 ColorPickerHeight="12"
                 ColorPickerFontSize="8"
                 ColorPickerWidth="150"
                 StartIconAnimation="True" LayoutUpdated="gridTitle_LayoutUpdated" Loaded="gridTitle_Loaded" SizeChanged="gridTitle_SizeChanged"
                 />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30*"/>
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="70*"/>
                </Grid.ColumnDefinitions>
                <ctrl:CustomizedScrollControl Grid.Column="0" x:Name="grdLeft" LayoutUpdated="grdLeft_LayoutUpdated" Loaded="grdLeft_Loaded" SizeChanged="grdLeft_SizeChanged">
                    <Grid  >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" 
                        Orientation="Vertical" VerticalAlignment="Center">
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Left" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="BackGround" VerticalAlignment="Center" Margin="4,2,4,2" Foreground="{Binding Path=CustomizedFgBrush,Mode=OneWay}"/>
                                <ctrl:CustomizedColorPicker Grid.Row="0" Grid.Column="1" x:Name="colorBackGround" Margin="4,2,4,2" SelectedColor="BlueViolet" TextForeground="White" Height="16" FontSize="9" DisplayColorAndName="True" ShowColorAndNameStreched="True" Width="120"/>
                                <TextBlock Grid.Row="1" Grid.Column="0"  Text="ForeGround" VerticalAlignment="Center" Margin="4,2,4,2" Foreground="{Binding Path=CustomizedFgBrush,Mode=OneWay}"/>
                                <ctrl:CustomizedColorPicker Grid.Row="1" Grid.Column="1" x:Name="colorForeGround" Margin="4,2,4,2" SelectedColor="LightGreen" Height="16"/>
                                <StackPanel Orientation="Horizontal" Margin="4,2,4,2" Grid.Row="2" Grid.Column="0" Grid.RowSpan="2" >
                                    <TextBlock Text="Test Text ..." VerticalAlignment="Center" Margin="8,0,4,0" FontSize="18">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding ElementName=colorForeGround, Path=SelectedColor}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <StackPanel.Background>
                                        <SolidColorBrush Color="{Binding Path=SelectedColor, ElementName=colorBackGround}"/>
                                    </StackPanel.Background>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="1" 
                        Orientation="Horizontal" Margin="0,5,0,5">
                            <TextBlock  TextWrapping="Wrap" Foreground="{Binding Path=CustomizedFgBrush,Mode=OneWay}" Width="65" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Run Text="Animation Image"/>
                            </TextBlock>
                            <Image Height="60" Source="/Resources/Novel9.jpg" Margin="4,0,4,0"/>
                            <ctrl:CustomizedRoundImage Height="60" Source="/Resources/Novel9.jpg" Style="{StaticResource xRoundImageStyle}" StartAnimation="False" Margin="4,0,4,0"/>
                            <ctrl:CustomizedRoundImage Height="60" Source="/Resources/Auto8.jpg" Style="{StaticResource xRoundImageStyle}" VerticalAlignment="Center" StartAnimation="True" x:Name="btnAnimationButton" Margin="4,0,4,0">
                            </ctrl:CustomizedRoundImage>
                            <Button Click="StartStopAnimation" Margin="3,5,3,5" Height="50" Width="70" >
                                <Button.Content>
                                    <TextBlock TextWrapping="WrapWithOverflow" HorizontalAlignment="Center" >Start/Stop Animation</TextBlock>
                                </Button.Content>
                            </Button>
                            <ctrl:CustomizedSlideUserControl Height="40" Width="40" Style="{DynamicResource xCustomizedSlideUserControlStyle}" SlideDirection="BottomToTop"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                            <StackPanel 
                            Orientation="Vertical" Margin="0,5,0,5" >
                                <TextBlock Text="DotNet Styled DatePicker" FontSize="18" FontWeight="Bold" Foreground="{Binding Path=CustomizedFgBrush,Mode=OneWay}"/>
                                <DatePicker x:Name="datePickerOrg" HorizontalAlignment="Left" Margin="0,2,0,2" VerticalAlignment="Top" Width="177" SelectedDateFormat="Long"></DatePicker>
                                <TextBlock Text="Enriched DatePicker" FontSize="18" FontWeight="Bold" Foreground="{Binding Path=CustomizedFgBrush,Mode=OneWay}"/>
                                <ctrl:CustomizedDatePicker Style="{DynamicResource xCustomizedDatePickerStyle}" x:Name="datePicker" HorizontalAlignment="Left" Margin="0,2,0,2" VerticalAlignment="Top" Width="177" SelectedDateFormat="Long"></ctrl:CustomizedDatePicker>
                            </StackPanel>
                            <ctrl:CustomizedSlideUserControl Margin="0,0,0,0"
                            Height="100" Width="100" HorizontalAlignment="Left" Style="{DynamicResource xCustomizedSlideUserControlStyle}" >
                                <ctrl:CustomizedSlideUserControl.ImageSourceList>
                                    <BitmapImage UriSource="/Resources/control4.png" />
                                    <BitmapImage UriSource="/Resources/control5.png" />
                                    <BitmapImage UriSource="/Resources/Test3.jpg" />
                                    <BitmapImage UriSource="/Resources/forward2.png" />
                                </ctrl:CustomizedSlideUserControl.ImageSourceList>
                            </ctrl:CustomizedSlideUserControl>
                        </StackPanel>
                        <ctrl:CustomizedImageButton Grid.Row="3"
                          Text="Image Button Sample" ImageSource="/Resources/Novel9.jpg" 
                          Style="{DynamicResource xCustomizedImageButtonStyle}" 
                          Height="40" Width="160" Margin="0,5,0,5"
                          FontSize="18"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          StartIconAnimation="True" >
                        </ctrl:CustomizedImageButton>

                        <ScrollViewer Grid.Row="4" Margin="0,5,0,5" x:Name="TextScrollView" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                                <TextBlock Text="Horizontal Scroll Text Block" Foreground="{Binding Path=CustomizedFgBrush}" FontSize="18" FontWeight="Bold"/>
                                <ctrl:CustomizedScrollTextBlock Style="{StaticResource xCustomizedScrollTextBlockStyle}">
                                    <ScrollViewer.Content>
                                        <TextBlock FontSize="18"
                    Text="This is line 1 with a long content to test independent horizontal scrolling.あいうえおかきくけこさしすせそなにぬねのやよん.long content to test independent horizontal scrolling." Background="White" Foreground="Green"/>
                                    </ScrollViewer.Content>
                                </ctrl:CustomizedScrollTextBlock>
                                <ctrl:CustomizedScrollTextBlock Style="{DynamicResource xCustomizedScrollTextBlockStyle}">
                                    <ScrollViewer.Content>
                                        <TextBlock FontSize="18"
                    Text="This is line 2 with a long content to test independent horizontal scrolling.あいうえおかきくけこさしすせそなにぬねのやよん.long content to test independent horizontal scrolling."  Foreground="Yellow"/>
                                    </ScrollViewer.Content>
                                </ctrl:CustomizedScrollTextBlock>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer  Grid.Row="5" Margin="0,5,0,5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden" MaxWidth="300" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                                <TextBlock Text="Vertical Scroll Text Block" Foreground="{Binding Path=CustomizedFgBrush}" FontStyle="Italic" FontWeight="Bold" FontSize="18" HorizontalAlignment="Left"/>
                                <ctrl:CustomizedScrollTextBlock 
                                Style="{DynamicResource xCustomizedScrollTextBlockStyle}" 
                                FontSize="16"
                                AnimationDirection="Vertical" Height="40" HorizontalAlignment="Left" BorderBrush="AliceBlue" BorderThickness="4" Margin="0,5,0,5">
                                    <ScrollViewer.Content>
                                        <TextBlock TextWrapping="NoWrap" Width="300">
                                    This is line 2 with a long content to test independent horizontal scrolling.
                                    <LineBreak/>This is line 3 with a long content to test independent horizontal scrolling.
                                    <LineBreak/>This is line 4 with a long content to test independent horizontal scrolling.
                                    <LineBreak/>This is line 5 with a long content to test independent horizontal scrolling.
                                    <LineBreak/>This is line 6 with a long content to test independent horizontal scrolling.
                                    <LineBreak/>This is line 7 with a long content to test independent horizontal scrolling.
                                    <LineBreak/>This is line 8 with a long content to test independent horizontal scrolling.
                                        </TextBlock>
                                    </ScrollViewer.Content>
                                </ctrl:CustomizedScrollTextBlock>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="6" Orientation="Vertical" Margin="0,5,0,5" >
                            <TextBlock Text="Scroll Text" Foreground="{Binding Path=CustomizedFgBrush,Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                            <ctrl:CustomizedSimpleScrollEdit x:Name="AutoScrollTextBox" 
                        IsReadOnly="False" 
                        Style="{DynamicResource xCustomizedSimpleScrollEditStyle}"
                        FontSize="18" Height="80" ScrollAnimation="True" HorizontalScrollBarVisibility="Hidden"/>
                        </StackPanel>
                    </Grid>
                </ctrl:CustomizedScrollControl>
                
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" x:Name="grdWebBrowser" LayoutUpdated="grdWebBrowser_LayoutUpdated" Loaded="grdWebBrowser_Loaded">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="txtUrl" Text="https://www.youtube.com"/>
                        <ctrl:CustomizedImageButton Grid.Column="2" Text="Go" ImageSource="/Resources/Back5.png" Height="25" Width="55" Style="{DynamicResource xCustomizedImageButtonStyle}" ImageMargin="-5,-5,-5,-5" Click="CustomizedImageButton_Click"/>
                    </Grid>
                    <ctrl:CustomizedNativeContainer Grid.Row="2"
                        x:Name="xNativeWebViewContainer" 
                        CornerRadius="20" Margin="0,0,0,0"
                        NativeCtrlClsName="EmptyContainer" CustomizedNativeCtrlClsNameInEmptyContainer="Microsoft.Web.WebView2.Wpf.WebView2">
                        <Wpf:WebView2 x:Name="webBrowser" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                            <!--Margin="-10,-25,5,25"-->
                            <Wpf:WebView2.Margin>
                                <MultiBinding Converter="{StaticResource MarginCustomizedConverterForIsidTestControlWindow}">
                                    <!--ConverterParameter="{x:Static local:YourStaticObject}"--> <!--ConverterParameter="100"-->
                                    <Binding ElementName="grdLeft" Path="ActualWidth"/>
                                    <Binding ElementName="grdWebBrowser" Path="ActualHeight"/>
                                    <Binding ElementName="gridTitle" Path="ActualHeight"/>
                                </MultiBinding>
                                <!--<Binding Source="100"/>-->
                                <!-- 传递常数 100 -->
                                <!--<Binding Source="{x:Static local:YourStaticObject}"/>-->
                                <!-- 传递对象 -->
                            </Wpf:WebView2.Margin>
                        </Wpf:WebView2>
                    </ctrl:CustomizedNativeContainer>
                    <!--<Wpf:WebView2  Grid.Row="2"
                         x:Name="webBrowser" 
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"/>-->
                </Grid>
            </Grid>

            <ctrl:CustomizedStatusBarGrid Grid.Row="2" Style="{DynamicResource xCustomizedStatusBarControlStyle}"
                x:Name="gridStatusBar" Background="Transparent">
                <StackPanel x:Name="stkStatusBar"  Orientation="Horizontal" >
                    <TextBlock x:Name="toolStripStatusFileName" Foreground="{Binding Path=CustomizedFgBrush,Mode=OneWay}" ToolTip="Status Area">Status Area ...</TextBlock>
                </StackPanel>
            </ctrl:CustomizedStatusBarGrid>
            <WrapPanel Grid.Row="2"/>
        </Grid>
    </Border>
</ctrl:GcjBaseWindow>

    