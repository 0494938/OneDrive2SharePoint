<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:WebV2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                    xmlns:GcjUiCtrl="clr-namespace:GcjUiCtrl.Control">
    <Style x:Key="xCustomizedTitleControlStyle" TargetType="GcjUiCtrl:CustomizedTitleControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GcjUiCtrl:CustomizedTitleControl">
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnMenu" Grid.Column="0" Margin="{TemplateBinding TitleIconMargin}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button.Content>
                                <!--Image x:Name="imgMenu" Margin="-8,-8,-8,-8"  Source="{TemplateBinding TitleImageSource}"/-->
                                <GcjUiCtrl:CustomizedRoundImage Grid.Column="2" Style="{StaticResource xRoundImageStyle}" Source="{TemplateBinding TitleImageSource}" Height="{TemplateBinding Height}" VerticalAlignment="Center"  StartAnimation="{TemplateBinding StartIconAnimation}">
                                    <Image.Clip>
                                        <EllipseGeometry 
                                        RadiusX="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Image}, Converter={StaticResource HalfValueConverter}}"
                                        RadiusY="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Image}, Converter={StaticResource HalfValueConverter}}">
                                            <EllipseGeometry.Center>
                                                <MultiBinding Converter="{StaticResource PointConverter}">
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Image}" />
                                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Image}" />
                                                </MultiBinding>
                                            </EllipseGeometry.Center>
                                        </EllipseGeometry>
                                    </Image.Clip>
                                </GcjUiCtrl:CustomizedRoundImage>

                            </Button.Content>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <!-- 使用Ellipse绘制圆形背景 -->
                                    <Grid>
                                        <Ellipse x:Name="ellipse" Stroke="Transparent" StrokeThickness="1"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <!-- 鼠标悬停效果 -->
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ellipse" Property="Fill" Value="SkyBlue"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock x:Name="txtTitle" Grid.Column="1" Foreground="{TemplateBinding TitleForeGround}" Text="{TemplateBinding TitleText}" FontWeight="Bold" VerticalAlignment="Top" Margin="10,0,0,0"/>
                        <!-- Config -->
                        <GcjUiCtrl:CustomizedColorPicker 
                            Grid.Column="2" x:Name="colorPicker" BorderThickness="0" 
                            BorderBrush="{TemplateBinding Background}" 
                            DisplayColorTooltip="True" 
                            DisplayColorAndName="True"
                            VerticalAlignment="Top"
                            FontSize="{TemplateBinding ColorPickerFontSize}"  
                            Height="{TemplateBinding ColorPickerHeight}"  
                            Width="{TemplateBinding ColorPickerWidth}"  
                            Margin="{TemplateBinding ColorPickerMargin}"
                            ShowColorAndNameStreched="True"
                            SelectedColor="{TemplateBinding SelectedColor}" Visibility="{TemplateBinding ShowBkColorPicker}"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-3,-3,0">
                            <!-- 最小化按钮 -->
                            <Button x:Name="btnMin" Background="LightGreen" HorizontalAlignment="Right" VerticalAlignment="Top" Width="{TemplateBinding SysButtonSize}" Height="{TemplateBinding SysButtonSize}" Visibility="{TemplateBinding ShowMinimumButton}">
                                <Button.Content>
                                    <Border CornerRadius="5" >
                                        <TextBlock Text="_" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                                    </Border>
                                </Button.Content>
                            </Button>
                            <!-- 最大化按钮 -->
                            <Button x:Name="btnMax" Background="LightGreen" HorizontalAlignment="Right" VerticalAlignment="Top" Width="{TemplateBinding SysButtonSize}" Height="{TemplateBinding SysButtonSize}" Visibility="{TemplateBinding ShowMaximumButton}">
                                <Button.Content>
                                    <Border CornerRadius="5" >
                                        <TextBlock Text="□" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                                    </Border>
                                </Button.Content>
                            </Button>
                            <!-- 关闭按钮 -->
                            <Button x:Name="btnClose" Background="LightGreen" HorizontalAlignment="Right" VerticalAlignment="Top" Width="{TemplateBinding SysButtonSize}" Height="{TemplateBinding SysButtonSize}" Visibility="{TemplateBinding ShowCloseButton}">
                                <Button.Content>
                                    <Border CornerRadius="5" >
                                        <TextBlock Text="X" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                                    </Border>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="xCustomizedAddressedWebView2Style" TargetType="GcjUiCtrl:CustomizedAddressedWebView2">
        <!--Padding="{TemplateBinding Padding}"-->
        <!--<Setter Property="IsMuted" Value="{Binding RelativeSource=webBrowser., Path=IsMuted}"/>-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GcjUiCtrl:CustomizedAddressedWebView2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="2" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <GcjUiCtrl:CustomizedTextBox Grid.Column="0" 
                                x:Name="txtUrl" Text="https://www.youtube.com"/>
                            <GcjUiCtrl:CustomizedImageButton Grid.Column="2" 
                                x:Name="btnNav"
                                Text="Go" ImageSource="/Back5.png" Height="25" Width="55" 
                                Style="{DynamicResource xCustomizedImageButtonStyle}" 
                                ImageMargin="-5,-5,-5,-5"/>
                        </Grid>
                        <GcjUiCtrl:CustomizedWebView2 Grid.Row="2" 
                            x:Name="webBrowser" 
                            ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                            Style="{DynamicResource xCustomizedWebView2Style}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

