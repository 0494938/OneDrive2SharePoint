    <Style x:Key="xCustomizedSlideUserControlStyle" TargetType="{x:Type GcjUiCtrl:CustomizedSlideUserControl}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="Transparent"/>
    </Style>

    <Style x:Key="xCustomizedRoundWebView2Style" TargetType="{x:Type GcjUiCtrl:CustomizedRoundWebView2}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GcjUiCtrl:CustomizedRoundWebView2}">
                    <!--<Border BorderBrush="Gray" BorderThickness="1" CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}">-->
                    <Border BorderBrush="Gray" BorderThickness="10" CornerRadius="10">
                        <WebV2:WebView2 x:Name="PART_WebView2"
                                Margin="10" 
                                Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Source, Mode=TwoWay}" />
                        <!--<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                        </ContentPresenter>-->
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="xCustomizedTabWebCtrlStyle" TargetType="GcjUiCtrl:CustomizedTabWebCtrl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GcjUiCtrl:CustomizedTabWebCtrl">
                    <Grid>
                        <TabControl ItemsSource="{TemplateBinding Items}">
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <GcjUiCtrl:CustomizedAddressedWebView2 Visibility="Visible"
                                            x:Name="webPage" 
                                            ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                                            Style="{DynamicResource xCustomizedAddressedWebView2Style}">
                                    </GcjUiCtrl:CustomizedAddressedWebView2>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                        </TabControl>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chrome-like TabItem Header Style -->
    <Style x:Key="xCustomizedChromeTabItemStyle" TargetType="GcjUiCtrl:WebVWTabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GcjUiCtrl:WebVWTabItem">
                    <!--<ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" CanContentScroll="True" MaxWidth="200" Width="60">
                    </ScrollViewer>-->
                    <Grid Width="100" MaxWidth="100">
                        <Border x:Name="ChromeBorder"
                                Background="LightGray"
                                BorderBrush="Gray"
                                BorderThickness="1,1,1,0"
                                CornerRadius="5,5,0,0"
                                Padding="10,5">
                            <!-- Header content -->
                            <!--<ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />-->
                            <Viewbox MaxWidth="200">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                            </Viewbox>
                            <!--<TextBlock Text="{Binding Header, RelativeSource={RelativeSource Self}}" MaxWidth="100" TextTrimming="CharacterEllipsis" />-->
                        </Border>
                    </Grid>
                    <!-- Define triggers for visual changes -->
                    <ControlTemplate.Triggers>
                        <!-- Trigger for selected tab -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ChromeBorder" Property="Background" Value="White" />
                            <Setter TargetName="ChromeBorder" Property="BorderBrush" Value="DarkGray" />
                        </Trigger>
                        <!-- Trigger for mouse over tab -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChromeBorder" Property="Background" Value="#FFDDDDDD" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>