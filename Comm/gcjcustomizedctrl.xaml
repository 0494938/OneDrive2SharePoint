    <Style x:Key="xCustomizedRoundContextMenuStyle" TargetType="{x:Type GcjUiCtrl:CustomizedRoundContextMenu}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GcjUiCtrl:CustomizedRoundContextMenu}">
                    <!--<Border Background="LightGray" 
                                BorderBrush="Gray" 
                                BorderThickness="1" 
                                CornerRadius="10">
                        <StackPanel>
                            <ItemsPresenter/>
                        </StackPanel>
                    </Border>-->
                    <Border BorderBrush="Gray" 
                            BorderThickness="1" 
                            CornerRadius="6">
                        <!-- 圆角设定 -->
                        <StackPanel>
                            <ItemsPresenter/>
                        </StackPanel>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <!-- 从浅蓝色到浅灰，覆盖 0 到 0.8 -->
                                <GradientStop Color="#E0F7FF" Offset="0" />
                                <GradientStop Color="White" Offset="0.8" />
                                <!-- 从浅灰回到浅蓝色，覆盖 0.8 到 1 -->
                                <GradientStop Color="#E0F7FF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="xCustomizedITransparentButtonStyle" TargetType="{x:Type GcjUiCtrl:CustomizedTransparentButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="Black"/>
        <!-- 设置按钮文字颜色 -->
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GcjUiCtrl:CustomizedTransparentButton}">
                    <ContentPresenter 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="xCustomizedRoundButtonStyle" TargetType="{x:Type GcjUiCtrl:CustomizedRoundButton}" >
        <Setter Property="Background" Value="LightBlue"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Gray"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GcjUiCtrl:CustomizedRoundButton}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <!-- 控制圆角大小 -->
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="xCustomizedFlatButtonStyle" TargetType="{x:Type GcjUiCtrl:CustomizedFlatButton}" >
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="LightGray"/>
        <Setter Property="Margin" Value="10,10,10,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <!--<ControlTemplate TargetType="{x:Type GcjUiCtrl:CustomizedFlatButton}">-->
                <ControlTemplate TargetType="{x:Type GcjUiCtrl:CustomizedFlatButton}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="xCustomizedFlatButtonStyle2" TargetType="{x:Type GcjUiCtrl:CustomizedFlatButton}" >
        <Setter Property="Background" Value="Transparent"/>
