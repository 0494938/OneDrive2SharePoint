    <!-- CustomizedListBox 的样式 -->
    <Style TargetType="{x:Type GcjUiCtrl:CustomizedListBox}" x:Key="xCustomizedListBoxStyle">
        <!--<Setter Property="Background" Value="#F5F5F5"/>-->
        <Setter Property="Background" Value="Transparent"/>
        <!--<Setter Property="BorderBrush" Value="#D3D3D3"/>-->
        <Setter Property="BorderBrush" Value="LightGray"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="5"/>
    </Style>

    <!-- CustomizedListBoxItem 的样式 -->
    <Style TargetType="ListBoxItem" x:Key="xCustomizedListBoxItemStyle">
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <!--<Setter Property="Background" Value="LightGray"/>-->
        <!--<Setter Property="Background" >
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E0F7FF" Offset="0" />
                    <GradientStop Color="White" Offset="0.7" />
                    <GradientStop Color="#E0F7FF" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>-->
        <Setter Property="BorderBrush" Value="Gray"/>
        <Setter Property="BorderThickness" Value="0.1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <!-- 交互状态 -->
        <Setter Property="Template">
            <Setter.Value>
                <!--<ControlTemplate TargetType="{x:Type GcjUiCtrl:CustomizedListBoxItem}">-->
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <!-- 触发器 -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F0F8FF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#ADD8E6"/>
                            <Setter Property="BorderBrush" Value="#1E90FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ItemTemplate 用于定义每项内容 -->
    <DataTemplate x:Key="xCustomizedListBoxItemDataTemplateStyle">
